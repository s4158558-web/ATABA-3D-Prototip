<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><title>ATABA 3D Prototip V1</title><style>html,body{margin:0;height:100%;overflow:hidden;background:#87b8d8;font-family:Arial;touch-action:none}#hud{position:fixed;top:12px;left:12px;right:12px;z-index:2;display:flex;justify-content:space-between;color:white;font-weight:bold}.b{background:#111c;padding:10px 14px;border-radius:14px}#c{position:fixed;bottom:20px;left:0;right:0;z-index:2;display:flex;justify-content:space-between;padding:0 24px}button{width:105px;height:68px;border:0;border-radius:20px;font-size:22px;font-weight:bold}canvas{display:block}</style><style id="ataba-landscape-v5">html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#87b9d8}body{touch-action:none}@media (orientation:portrait){body::before{content:"📱 Lütfen tableti yatay çevir";position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:#20252b;color:#fff;font:800 24px system-ui;text-align:center;padding:24px;box-sizing:border-box}}</style></head><body><div id="hud"><div class="b">🚗 ATABA 3D</div><div class="b" id="sp">0 km/h</div><div class="b" id="sensor">DİREKSİYON: BEKLİYOR</div></div><div id="c"><button id="f">FREN</button><button id="g">GAZ</button></div><script type="module">
import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js';
const s=new THREE.Scene();s.background=new THREE.Color(0x87b8d8);s.fog=new THREE.Fog(0x87b8d8,70,220);
const cam=new THREE.PerspectiveCamera(65,innerWidth/innerHeight,.1,500);cam.position.set(0,5,10);
const ren=new THREE.WebGLRenderer({antialias:true});ren.setSize(innerWidth,innerHeight);ren.setPixelRatio(Math.min(devicePixelRatio,2));ren.shadowMap.enabled=true;document.body.appendChild(ren.domElement);
s.add(new THREE.HemisphereLight(0xffffff,0x506050,2));let sun=new THREE.DirectionalLight(0xffffff,2);sun.position.set(-30,50,20);s.add(sun);
function plane(w,d,c){let m=new THREE.Mesh(new THREE.PlaneGeometry(w,d),new THREE.MeshStandardMaterial({color:c}));m.rotation.x=-Math.PI/2;return m}
let grass=plane(500,500,0x55734c);grass.position.y=-.05;s.add(grass);let road=plane(12,500,0x30343a);s.add(road);
for(let z=-240;z<250;z+=12){let x=new THREE.Mesh(new THREE.BoxGeometry(.2,.03,6),new THREE.MeshBasicMaterial({color:0xffffff}));x.position.set(0,.02,z);s.add(x)}
function car(c){let q=new THREE.Group(),m=new THREE.MeshStandardMaterial({color:c,roughness:.6}),b=new THREE.Mesh(new THREE.BoxGeometry(2.2,.75,4.1),m);b.position.y=.75;q.add(b);let cab=new THREE.Mesh(new THREE.BoxGeometry(1.65,.7,1.9),new THREE.MeshStandardMaterial({color:0x263640}));cab.position.set(0,1.35,-.15);q.add(cab);return q}
let p=car(0x172229);p.position.z=6;s.add(p);let traffic=[];for(let i=0;i<7;i++){let q=car([0x8b1e1e,0xeee7d0,0x1d4e89,0x555555,0xc47b21][i%5]);q.scale.setScalar(.9);q.position.set([-4,-1.3,1.3,4][i%4],0,-25-i*30);s.add(q);traffic.push(q)}
let k={g:0,f:0},speed=0,tilt=0;function bind(id,n){let b=document.getElementById(id);b.onpointerdown=()=>k[n]=1;b.onpointerup=()=>k[n]=0;b.onpointercancel=()=>k[n]=0;b.onpointerleave=()=>k[n]=0}bind('g','g');bind('f','f');
let sensorReady=false, sensorZero=0, filteredTilt=0, orientationStarted=false;
const sensorEl=document.getElementById('sensor');

function handleOrientation(e){
  if(typeof e.gamma==='number' && Number.isFinite(e.gamma)){
    const raw=THREE.MathUtils.clamp((e.gamma-sensorZero)/22,-1,1);
    filteredTilt=THREE.MathUtils.lerp(filteredTilt,raw,.28);
    tilt=filteredTilt;
    sensorReady=true;
    sensorEl.textContent='DİREKSİYON: '+Math.round(tilt*100)+'%';
  }
}

async function startMotion(){
  if(orientationStarted) return;
  orientationStarted=true;
  try{
    if(typeof DeviceOrientationEvent==='undefined'){
      sensorEl.textContent='BU TARAYICI SENSÖRÜ DESTEKLEMİYOR';
      return;
    }
    if(typeof DeviceOrientationEvent.requestPermission==='function'){
      const r=await DeviceOrientationEvent.requestPermission();
      if(r!=='granted'){
        sensorEl.textContent='SENSÖR İZNİ VERİLMEDİ';
        orientationStarted=false;
        return;
      }
    }
    addEventListener('deviceorientation',handleOrientation,{passive:true});
    sensorEl.textContent='TABLETİ SAĞ/SOLA EĞ';
    setTimeout(()=>{
      if(!sensorReady) sensorEl.textContent='SENSÖR YOK — HTTPS GEREKLİ OLABİLİR';
    },1800);
  }catch(err){
    orientationStarted=false;
    sensorEl.textContent='SENSÖR BAŞLATILAMADI';
  }
}

const startBtn=document.createElement('button');
startBtn.textContent='🎮 DİREKSİYONU BAŞLAT';
startBtn.style.cssText='position:fixed;left:50%;top:92px;transform:translateX(-50%);z-index:20;padding:12px 18px;border:0;border-radius:12px;background:#fff;font-weight:800;font-size:16px;box-shadow:0 3px 10px #0004;';
document.body.appendChild(startBtn);
startBtn.addEventListener('click',async()=>{
  await startMotion();
  setTimeout(()=>{ if(sensorReady) startBtn.remove(); },300);
});
if(window.isSecureContext) sensorEl.textContent='DİREKSİYON BAŞLATILMAYA HAZIR';
else sensorEl.textContent='DOSYA MODU — HTTPS İLE AÇILMALI';
let clock=new THREE.Clock();function loop(){requestAnimationFrame(loop);let dt=Math.min(clock.getDelta(),.04);if(k.g) speed=Math.min(1,speed+dt*.7); else speed=Math.max(0,speed-dt*.35); if(k.f) speed=Math.max(0,speed-dt*1.8); let st=tilt; const steerPower=(4.5+speed*9); p.position.x=THREE.MathUtils.clamp(p.position.x+st*dt*steerPower,-4.7,4.7); p.rotation.y=THREE.MathUtils.lerp(p.rotation.y,-st*.22,dt*8);for(let q of traffic){q.position.z+=(12+speed*48)*dt;if(q.position.z>20){q.position.z=-210-Math.random()*80;q.position.x=[-4,-1.3,1.3,4][Math.floor(Math.random()*4)]}}cam.position.x=THREE.MathUtils.lerp(cam.position.x,p.position.x*.55,dt*4);cam.lookAt(p.position.x*.25,1,-8);document.getElementById('sp').textContent=Math.round(speed*120)+' km/h';ren.render(s,cam)}loop();addEventListener('resize',()=>{cam.aspect=innerWidth/innerHeight;cam.updateProjectionMatrix();ren.setSize(innerWidth,innerHeight)});
</script><script>(async()=>{try{if(screen.orientation&&screen.orientation.lock)await screen.orientation.lock('landscape')}catch(e){}})();</script></body></html>
